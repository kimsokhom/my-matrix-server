# ── Local development ──────────────────────────────────────────────────────────
# Leave VITE_BRIDGE_URL empty so Vite proxies /_matrix/provision/* to the bridge.
# The proxy target is also read from this file (see vite.config.js).
VITE_BRIDGE_URL=

# ── Production (Railway) ───────────────────────────────────────────────────────
# Set VITE_BRIDGE_URL to your Railway bridge URL before running `npm run build`.
# VITE_BRIDGE_URL=https://mautrix-telegram-xyz.up.railway.app

# ── Both environments ──────────────────────────────────────────────────────────
# provisioning.shared_secret from the bridge config.yaml
# Option A: grep shared_secret /etc/mautrix-telegram/config.yaml  (Railway shell)
# Option B: set a fixed value in bridge config instead of "generate"
VITE_PROVISIONING_SECRET=your-provisioning-secret-here

# ── Local dev only — Matrix user ID fallback ───────────────────────────────────
# In Element Web, user_id is injected automatically via the widget URL template.
# When testing locally outside Element, set this so API calls include ?user_id=...
VITE_MATRIX_USER_ID=@youruser:yourdomain.com

# ── Your hosted Element Web (browser fallback for "Open chat" / "Start DM") ─────
# When the widget runs in a plain browser tab (not embedded in Element), opening
# a chat deep-links into YOUR Element instance instead of the public matrix.to
# page (which would send users to the public Element server). No trailing slash.
# Leave empty to fall back to matrix.to.
# VITE_ELEMENT_BASE_URL=https://element-web-test-kim-sokhom-matrix-email-bridge.up.railway.app
