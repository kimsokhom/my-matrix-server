# ════════════════════════════════════════════════════════════════════════════
#  SECURITY MODEL (read SECURITY.md)
#  The provisioning secret is held ONLY by the server (server.js / the dev proxy),
#  never the browser. It is PROVISIONING_SECRET — deliberately NOT a VITE_ var, so
#  it is never compiled into the client bundle. The server verifies each user's
#  Matrix OpenID token and derives their user_id; the browser cannot impersonate.
# ════════════════════════════════════════════════════════════════════════════

# ── Client build-time (VITE_*) ──────────────────────────────────────────────────
# Leave VITE_BRIDGE_URL EMPTY so the client calls the same-origin proxy at
# /_matrix/provision/* (the proxy injects the secret). Only set this if you
# intentionally bypass the proxy (not recommended).
VITE_BRIDGE_URL=

# ── Server-only (NO VITE_ prefix → never bundled) ───────────────────────────────
# Used by server.js in production AND by the Vite dev proxy locally.

# provisioning.shared_secret from the bridge config.yaml
#   grep shared_secret /etc/mautrix-telegram/config.yaml   (Railway shell)
PROVISIONING_SECRET=your-provisioning-secret-here

# The bridge URL the proxy forwards to. In production use the PRIVATE network URL
# so the bridge's provisioning endpoint is never public (see SECURITY.md).
#   e.g. http://mautrix-telegram.railway.internal:29317
BRIDGE_INTERNAL_URL=

# Homeserver used to verify OpenID tokens AND pinned (tokens for any other server
# name are rejected). No scheme, just the server name.
HOMESERVER_NAME=synapse-kim-sokhom-matrix-email-bridge.up.railway.app

# How long a verified token is trusted before re-checking (ms). Optional.
# OPENID_VERIFY_TTL_MS=60000

# ── Local dev only — Matrix user ID fallback ───────────────────────────────────
# There is no Element host locally to issue an OpenID token, so set this to a
# Matrix ID for testing; the dev proxy forwards it as ?user_id=. This whole path
# is compiled OUT of production builds.
VITE_MATRIX_USER_ID=@youruser:yourdomain.com

# ── Dev-only — hosted Element Web (browser fallback for "Open chat") ────────────
# Only used by the dev-gated standalone-browser path. In production the widget
# runs inside Element and navigates in-place, so this is not used there.
# Prefer your gateway/nginx URL (nginx serves Element Web at "/"). Trailing slash
# is stripped automatically. Leave empty to fall back to matrix.to.
# VITE_ELEMENT_BASE_URL=https://synapse-kim-sokhom-matrix-email-bridge.up.railway.app
